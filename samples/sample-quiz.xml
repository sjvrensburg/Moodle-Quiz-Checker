<?xml version="1.0" encoding="UTF-8"?>
<quiz>
  <question type="category">
    <category>
      <text>$course$/top/Sample Quiz</text>
    </category>
  </question>

  <question type="description">
    <name>
      <text>Instructions</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Welcome to the <strong>sample quiz</strong>. Answer every question to the best of your ability.</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text></text>
    </generalfeedback>
    <defaultgrade>0.0000000</defaultgrade>
    <penalty>0.0000000</penalty>
    <hidden>0</hidden>
  </question>

  <question type="multichoice">
    <name>
      <text>Capital of France</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>What is the capital of <em>France</em>?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[<p>Paris has been the capital of France since the 10th century.</p>]]></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <correctfeedback format="html">
      <text><![CDATA[<p>Correct!</p>]]></text>
    </correctfeedback>
    <partiallycorrectfeedback format="html">
      <text><![CDATA[<p>Partially correct.</p>]]></text>
    </partiallycorrectfeedback>
    <incorrectfeedback format="html">
      <text><![CDATA[<p>Incorrect.</p>]]></text>
    </incorrectfeedback>
    <answer fraction="100" format="html">
      <text><![CDATA[Paris]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[London]]></text>
      <feedback format="html"><text><![CDATA[<p>That is the capital of the UK.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Berlin]]></text>
      <feedback format="html"><text><![CDATA[<p>That is the capital of Germany.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Madrid]]></text>
      <feedback format="html"><text><![CDATA[<p>That is the capital of Spain.</p>]]></text></feedback>
    </answer>
  </question>

  <question type="multichoice">
    <name>
      <text>Prime numbers</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Select <strong>all</strong> prime numbers below.</p>]]></text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>false</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="25" format="html"><text><![CDATA[2]]></text></answer>
    <answer fraction="25" format="html"><text><![CDATA[3]]></text></answer>
    <answer fraction="-25" format="html"><text><![CDATA[4]]></text></answer>
    <answer fraction="25" format="html"><text><![CDATA[5]]></text></answer>
  </question>

  <question type="truefalse">
    <name>
      <text>Great Wall visibility</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>The Great Wall of China is visible from space with the naked eye.</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[<p>This is a common myth; it is not visible without aid.</p>]]></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>1.0000000</penalty>
    <hidden>0</hidden>
    <answer fraction="0" format="moodle_auto_format"><text>true</text><feedback format="html"><text></text></feedback></answer>
    <answer fraction="100" format="moodle_auto_format"><text>false</text><feedback format="html"><text></text></feedback></answer>
  </question>

  <question type="shortanswer">
    <name>
      <text>Chemical symbol</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>What is the chemical symbol for water?</p>]]></text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <usecase>0</usecase>
    <answer fraction="100" format="plain_text">
      <text>H2O</text>
      <feedback format="html"><text><![CDATA[<p>Correct.</p>]]></text></feedback>
    </answer>
    <answer fraction="50" format="plain_text">
      <text>H*O</text>
      <feedback format="html"><text><![CDATA[<p>Close, check subscripts.</p>]]></text></feedback>
    </answer>
  </question>

  <question type="numerical">
    <name>
      <text>Speed of light</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>What is the approximate speed of light in a vacuum, in km/s (to the nearest 1000)?</p>]]></text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <answer fraction="100" format="plain_text">
      <text>300000</text>
      <tolerance>1000</tolerance>
      <feedback format="html"><text><![CDATA[<p>Correct.</p>]]></text></feedback>
    </answer>
    <units>
      <unit>
        <multiplier>1</multiplier>
        <unit_name>km/s</unit_name>
      </unit>
    </units>
  </question>

  <question type="matching">
    <name>
      <text>Capitals matching</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Match each country to its capital.</p>]]></text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <shuffleanswers>true</shuffleanswers>
    <subquestion format="html">
      <text><![CDATA[Japan]]></text>
      <answer><text>Tokyo</text></answer>
    </subquestion>
    <subquestion format="html">
      <text><![CDATA[Italy]]></text>
      <answer><text>Rome</text></answer>
    </subquestion>
    <subquestion format="html">
      <text><![CDATA[Canada]]></text>
      <answer><text>Ottawa</text></answer>
    </subquestion>
  </question>

  <question type="cloze">
    <name>
      <text>Cloze basics</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>The capital of France is {1:SHORTANSWER:=Paris#Correct~%50%Paris *#Close}. Two plus two equals {2:NUMERICAL:=4:0#Correct}. Water is a {3:MULTICHOICE:%100%liquid#Correct~%0%solid#Wrong~%0%gas#Wrong} at room temperature.]]></text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>3.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
  </question>

  <question type="essay">
    <name>
      <text>Reflection</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>In 2-3 sentences, describe what you learned from this quiz.</p>]]></text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.0000000</penalty>
    <hidden>0</hidden>
    <responseformat>editor</responseformat>
    <responserequired>1</responserequired>
    <responsefieldlines>10</responsefieldlines>
    <attachments>0</attachments>
    <attachmentsrequired>0</attachmentsrequired>
    <graderinfo format="html"><text></text></graderinfo>
  </question>
</quiz>
